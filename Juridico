<body>
<div class="wrap">
<header>
  <div>
    <div class="brand"><div class="logo"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M7 21h10M5 7h14"/><path d="M5 7l-3 7a3.2 3.2 0 0 0 6 0L5 7zM19 7l-3 7a3.2 3.2 0 0 0 6 0l-3-7z"/></svg></div><h1>Controle Jurídico<span class="h1-div"></span><span class="h1-sub">Contratos</span></h1></div>
    <div class="sub">Prazo máximo de retorno: <input id="sla" type="number" min="1" max="60" title="Altere se a regra mudar (vale para novos registros)"> dias úteis</div>
  </div>
  <div class="tools">
    <button class="sm" onclick="openRep()" title="Gera o relatório de fechamento de um mês">📄 Relatório mensal</button>
    <button class="sm" onclick="exportCSV()" title="Baixa todos os registros em uma planilha (CSV) para abrir no Excel">⬇ Baixar planilha</button>
    <button class="sm" onclick="hist.showModal()" title="Consultar quando e para quem cada e-mail foi disparado">📨 Histórico</button>
    <button class="sm" onclick="openCfg()" title="Definir quem recebe os e-mails e ligar o envio automático">✉ Configurar e-mails</button>
    <!-- TESTE TEMPORÁRIO: remover este botão quando estiver tudo ok -->
    <button class="sm test" onclick="testMail()" title="Dispara um e-mail de teste (temporário)">🧪 Teste de disparo</button>
  </div>
</header>

<div class="periodo"><div class="tabs" id="tmonth"></div></div>

<div class="stats" id="stats"></div>

<div class="card">
  <div class="sec"><h3>Nova solicitação</h3><div class="hint">Preencha os dados e o prazo é calculado automaticamente.</div></div>
  <form id="f">
    <label>Controle do cliente<input name="ctrl" required placeholder="Nº do cliente"></label>
    <label>Razão social<input name="rz" required placeholder="Nome da empresa"></label>
    <label>Data da solicitação<input name="dt" type="date" required></label>
