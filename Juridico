      <select id="rm" onchange="repRender()" style="width:auto"></select><select id="ry" onchange="repRender()" style="width:auto"></select></div>
    <div style="display:flex;gap:6px"><button class="sm" onclick="repCSV()">⬇ Planilha</button><button class="sm" onclick="window.print()">🖨 Imprimir / PDF</button><button class="sm" onclick="rep.close()">Fechar</button></div>
  </div>
  <div id="repbody"></div>
</dialog>
<dialog id="hist" style="max-width:860px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px"><h3>📨 Histórico de e-mails</h3><button class="sm" onclick="hist.close()">Fechar</button></div>
  <div class="hint">"Disparado" significa que o pedido foi enviado ao Apps Script; a confirmação final de entrega fica na pasta Enviados do Gmail da conta do script.</div>
  <div class="tw"><table id="lgt" style="min-width:0;width:100%;table-layout:auto"><thead><tr><th>Data e hora</th><th>Tipo</th><th>Assunto</th><th>Para</th><th>Resultado</th></tr></thead><tbody id="lg"></tbody></table></div>
</dialog>
<dialog id="cfg">
  <h3>Destinatários dos e-mails</h3>
  <div class="hint">Digite um e-mail e pressione Enter (ou vírgula) para adicionar. Pode incluir quantos quiser.</div>
  <input id="em" type="email" placeholder="nome@empresa.com" style="width:100%">
  <div class="chips" id="chips"></div>
  <label>URL do Google Apps Script (envio automático)<input id="url" placeholder="https://script.google.com/macros/s/.../exec"></label>
  <details><summary>Como obter a URL (código do Apps Script)</summary>
<pre>function doPost(e){
  var d = JSON.parse(e.postData.contents);
  MailApp.sendEmail({to: d.to, subject: d.subject, body: d.body, htmlBody: d.html});
  return ContentService.createTextOutput("ok");
}</pre>
  <p style="margin-top:8px">Em script.google.com crie um projeto, cole o código, vá em Implantar → Nova implantação → App da Web (acesso: Qualquer pessoa) e copie a URL. Se já tinha criado o script antes, troque o código por este e reimplante: Implantar → Gerenciar implantações → editar → Nova versão.</p></details>
  <div style="display:flex;gap:8px;justify-content:flex-end"><button class="sm" onclick="cfg.close()">Cancelar</button><button onclick="saveCfg()">Salvar</button></div>
</dialog>
<div id="toast"></div>

<script>
const $=s=>document.querySelector(s);
let S={recs:[],to:[],url:'',sla:5,log:[]};
try{S=Object.assign(S,JSON.parse(localStorage.getItem('cj')||'{}'))}catch(e){}
if(typeof S.to==='string')S.to=S.to.split(/[,;\s]+/).filter(Boolean);
const save=()=>{try{localStorage.setItem('cj',JSON.stringify(S))}catch(e){}};
const D=s=>{const[a,b,c]=s.split('-').map(Number);return new Date(a,b-1,c)};
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const br=s=>s?s.split('-').reverse().join('/'):'—';
const today=()=>iso(new Date());
const MIN=['de','da','do','das','dos','e'];
function titleCase(t){return t.trim().toLowerCase().split(/\s+/).map((w,i)=>i&&MIN.includes(w)?w:w.replace(/(^|[-\/(.])(\p{L})/gu,(m,a,b)=>a+b.toUpperCase())).join(' ')}
function saudacao(){const h=new Date().getHours();return h<12?'Bom dia':h<18?'Boa tarde':'Boa noite'}
S.recs.forEach(r=>{r.rz=titleCase(r.rz)});
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function addBD(s,n){const d=D(s);while(n>0){d.setDate(d.getDate()+1);if(d.getDay()%6)n--}return iso(d)}
function bdBetween(a,b){let d=D(a),e=D(b),n=0;const sg=d<=e?1:-1;while(iso(d)!==iso(e)){d.setDate(d.getDate()+sg);if(d.getDay()%6)n+=sg}return n}
function toast(m,act,ms=5000){const t=document.createElement('div');t.className='t';t.append(m);
  if(act){const b=document.createElement('button');b.textContent=act.label;b.onclick=()=>{act.fn();t.remove()};t.append(b)}
  $('#toast').append(t);setTimeout(()=>t.remove(),ms)}

const THEME={
 'Nova solicitação':{c1:'#5b3df5',c2:'#22d3ee',tag:'NOVA SOLICITAÇÃO',ico:'📄',msg:'Uma nova análise de contrato foi registrada e aguarda o retorno do jurídico.'},
 'Concluído':{c1:'#059669',c2:'#34d399',tag:'CONCLUÍDO',ico:'✅',msg:'O jurídico retornou a solicitação.'},
 'Prazo vencido':{c1:'#dc2626',c2:'#f59e0b',tag:'PRAZO VENCIDO',ico:'⚠️',msg:'O prazo do jurídico foi ultrapassado e precisa de atenção imediata.'},
 'Teste':{c1:'#d97706',c2:'#fbbf24',tag:'TESTE',ico:'🧪',msg:'E-mail de teste do painel Controle Jurídico.'}
};
function rowsHtml(rows,t){return rows.map(([k,v],i)=>{
  const bd=i?'border-top:1px solid #e6e9f5;':'';
  const val=i===0?'<span style="display:inline-block;background:'+t.c1+';color:#ffffff;font-size:15px;font-weight:700;padding:5px 14px;border-radius:99px;letter-spacing:.3px">'+v+'</span>':v;
  return '<tr><td style="padding:12px 0;'+bd+'font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#5b6085;font-weight:700;white-space:nowrap;width:190px;padding-right:18px;font-family:Arial,sans-serif">'+k+'</td><td style="padding:12px 0;'+bd+'font-size:16px;font-weight:700;color:#10122a;text-align:left;font-family:Arial,sans-serif">'+val+'</td></tr>'}).join('')}
function premium(tipo,rows,extra){
  const t=THEME[tipo]||THEME['Teste'];
  return '<div style="background:#eef0fa;padding:28px 12px;font-family:Arial,Helvetica,sans-serif">'
  +'<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:660px;margin:auto"><tr><td>'
  +'<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:18px;overflow:hidden;box-shadow:0 12px 40px rgba(26,28,51,.14)">'
  +'<tr><td style="background:#0b0d17;background-image:linear-gradient(135deg,#0b0d17 0%,'+t.c1+' 100%);padding:18px 30px 20px">'
  +'<table role="presentation" width="100%"><tr><td style="font-size:11px;letter-spacing:2.5px;color:#c9ccf0;font-weight:700">⚖️ &nbsp;CONTROLE JURÍDICO</td>'
  +'<td align="right"><span style="display:inline-block;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);color:#fff;font-size:10px;font-weight:700;letter-spacing:1.4px;padding:5px 12px;border-radius:99px">'+t.tag+'</span></td></tr></table>'
  +'<div style="font-size:20px;line-height:1.3;color:#ffffff;font-weight:700;letter-spacing:-.2px;margin-top:14px">'+t.ico+' &nbsp;'+extra.title+'</div>'
  +'<div style="font-size:13px;line-height:1.5;color:#d6d9f5;margin-top:5px">'+t.msg+'</div></td></tr>'
  +'<tr><td style="height:3px;background:'+t.c2+';background-image:linear-gradient(90deg,'+t.c1+','+t.c2+');font-size:0;line-height:0">&nbsp;</td></tr>'
  +'<tr><td style="padding:24px 30px 6px"><p style="margin:0 0 16px;font-size:15px;color:#1a1c33">'+saudacao()+',</p>'
  +(extra.badge?'<div style="margin:0 0 16px;padding:12px 16px;border-radius:10px;background:#f5f6fd;border-left:4px solid '+t.c1+';font-size:14px;line-height:1.5;color:#1a1c33">'+extra.badge+'</div>':'')
  +'<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #d9dcf0;border-top:3px solid '+t.c1+';border-radius:12px;box-shadow:0 4px 14px rgba(26,28,51,.07)"><tr><td style="padding:6px 22px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0">'+rowsHtml(rows,t)+'</table></td></tr></table>'
  +(extra.note?'<p style="margin:18px 0 0;font-size:13px;line-height:1.6;color:#666b8c">'+extra.note+'</p>':'')
  +'</td></tr>'
  +'<tr><td style="padding:20px 30px 24px"><table role="presentation" width="100%"><tr><td style="border-top:1px solid #eceef6;padding-top:14px;font-size:11px;line-height:1.6;color:#9a9eba;text-align:center">Mensagem automática do painel <b style="color:#5b3df5">Controle Jurídico</b><br>Enviada em '+new Date().toLocaleString('pt-BR')+' · Não responda este e-mail</td></tr></table></td></tr>'
  +'</table></td></tr></table></div>';
}
async function mail(tipo,subject,html){
  const text=html.replace(/<(br|\/tr|\/div|\/p)[^>]*>/g,'\n').replace(/<[^>]+>/g,'').replace(/&nbsp;/g,' ').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&amp;/g,'&').replace(/\n\s*\n+/g,'\n').trim();
  const e={ts:Date.now(),tipo,subject,to:S.to.join(', ')};
  if(!S.to.length){e.res='Não enviado – sem destinatários';e.cls='er'}
  else if(S.url){
    try{await fetch(S.url,{method:'POST',mode:'no-cors',body:JSON.stringify({to:S.to.join(','),subject,body:text,html})});e.res='Disparado';e.cls='ok'}
    catch(x){e.res='Falha no disparo';e.cls='er'}
  }else{window.open('mailto:'+S.to.join(',')+'?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(text));e.res='Aberto no e-mail manual';e.cls='wa'}
  S.log.unshift(e);S.log=S.log.slice(0,200);save();renderLog();
  toast((e.cls==='ok'?'📧 ':'⚠ ')+e.res+': '+subject);
}
function testMail(){mail('Teste','🧪 Teste – Controle Jurídico',premium('Teste',[['Status','Disparo de teste'],['Enviado em',new Date().toLocaleString('pt-BR')]],{title:'Teste de disparo',note:'Se você recebeu este e-mail, o envio automático está funcionando.'}))}

const status=r=>r.done?'concluido':(today()>r.prazo?'atrasado':'pendente');
const dataRows=r=>[['Controle',esc(r.ctrl)],['Razão social',esc(r.rz)],['Data da solicitação',br(r.dt)],['Prazo de retorno',br(r.prazo)+' <span style="font-size:12px;color:#8b90b0;font-weight:400">('+r.sla+' dias úteis)</span>']];

/* prazo editável */
$('#sla').value=S.sla;
$('#sla').onchange=()=>{const v=parseInt($('#sla').value);if(v>=1){S.sla=v;save();upPrazo();toast('Prazo alterado para '+v+' dias úteis (novos registros).')}else $('#sla').value=S.sla};
$('[name=dt]').value=today();
const upPrazo=()=>{const v=$('[name=dt]').value;$('#prazo').value=v?br(addBD(v,S.sla)):''};
$('[name=dt]').oninput=upPrazo;upPrazo();
$('[name=rz]').onblur=e=>{e.target.value=titleCase(e.target.value)};

$('#f').onsubmit=e=>{
  e.preventDefault();const f=new FormData(e.target);
  const r={id:Date.now(),ctrl:f.get('ctrl').trim(),rz:titleCase(f.get('rz')),dt:f.get('dt'),ins:today(),sla:S.sla,prazo:addBD(f.get('dt'),S.sla),done:null,dias:null,alerted:false};
  S.recs.unshift(r);PY=r.dt.slice(0,4);PM=+r.dt.slice(5,7);save();render();
  mail('Nova solicitação','Registro de análise de contrato inserido – '+r.ctrl+' – '+r.rz,premium('Nova solicitação',[['Número de controle',esc(r.ctrl)],['Empresa',esc(r.rz)],['Data de inserção',br(r.ins)],['Data limite de retorno','<span style="color:#5b3df5">'+br(r.prazo)+'</span> <span style="font-size:12px;color:#8b90b0;font-weight:400">('+r.sla+' dias úteis)</span>']],{title:'Registro de análise de contrato inserido'}));
  e.target.reset();$('[name=dt]').value=today();upPrazo();
  checkOverdue(); /* registro antigo: dispara o aviso de prazo vencido na hora */
};

const T={};
function conclude(id){
  const r=S.recs.find(x=>x.id===id);r.done=today();r.dias=bdBetween(r.dt,r.done);save();render();
  toast(`Concluído em ${r.dias} dia(s) útil(eis). E-mail será enviado em 8s.`,{label:'Desfazer',fn:()=>reopen(id)},8000);
  T[id]=setTimeout(()=>{delete T[id];if(!r.done)return;
    const atraso=r.dias-r.sla;
    mail('Concluído','✅ Solicitação concluída em '+r.dias+' dia(s) útil(eis) – '+r.ctrl+' – '+r.rz,
      premium('Concluído',dataRows(r).concat([['Data de conclusão',br(r.done)],['Tempo gasto',r.dias+' dia(s) útil(eis)']]),{title:'Solicitação concluída em '+r.dias+' dia(s) útil(eis)',badge:atraso>0?'⚠️ <b>Fora do prazo</b> — '+atraso+' dia(s) útil(eis) acima do limite.':'✅ <b>Dentro do prazo.</b>'}))
  },8000);
}
function reopen(id){
  const r=S.recs.find(x=>x.id===id);
  if(T[id]){clearTimeout(T[id]);delete T[id]}
  r.done=null;r.dias=null;save();render();toast('Conclusão desfeita. Registro voltou para a lista.');
}
function del(id){if(confirm('Excluir este registro?')){S.recs=S.recs.filter(x=>x.id!==id);save();render()}}
function checkOverdue(){
  S.recs.forEach(r=>{if(!r.done&&!r.alerted&&today()>r.prazo){r.alerted=true;save();
    mail('Prazo vencido','⚠ PRAZO VENCIDO – '+r.ctrl+' – '+r.rz,premium('Prazo vencido',dataRows(r).concat([['Dias úteis de atraso','<span style="color:#dc2626">'+bdBetween(r.prazo,today())+'</span>']]),{title:'Prazo de '+r.sla+' dias úteis ultrapassado'}))}});
  render();
}

let FL='';
function setFilter(v){FL=v;$('#fl').value=v;render()}
$('#stats').onclick=e=>{const c=e.target.closest('[data-f]');if(c)setFilter(c.dataset.f)};
$('#fl').onchange=()=>setFilter($('#fl').value);
$('#q').oninput=render;

/* período (ano / mês da solicitação) */
const MESES=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const MABR=['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
let PY=null,PM=0; // PY: ano ('' = todos) | PM: 0 = ano inteiro, 1-12 = mês
const inPeriod=r=>(!PY||r.dt.slice(0,4)===PY)&&(!PM||+r.dt.slice(5,7)===PM);
function setYear(y){PY=y;PM=(y===today().slice(0,4))?+today().slice(5,7):0;render()}
function setMonth(m){PM=m;render()}
function renderTabs(ALL){
  const late=r=>status(r)==='atrasado';
  const cy=today().slice(0,4);
  const years=[...new Set(ALL.map(r=>r.dt.slice(0,4)).concat(cy))].sort().reverse();
  if(PY===null){PY=cy;PM=+today().slice(5,7)}
  const opt=(v,t,l)=>`<option value="${v}"${PY===v?' selected':''}>${t} (${l.length})</option>`;
  let h=`<select aria-label="Ano" onchange="setYear(this.value)">${opt('','Todos os anos',ALL)}${years.map(y=>opt(y,y,ALL.filter(r=>r.dt.slice(0,4)===y))).join('')}</select>`;
  if(!PY){$('#tmonth').innerHTML=h;return}
  const Y=ALL.filter(r=>r.dt.slice(0,4)===PY);
  h+=`<button type="button" class="${!PM?'on':''}${Y.some(late)?' has-late':''}" onclick="setMonth(0)">Ano inteiro<i>${Y.length}</i></button>`;
  for(let i=1;i<=12;i++){const L=Y.filter(r=>+r.dt.slice(5,7)===i);
    h+=`<button type="button" title="${MESES[i-1]} ${PY}" class="${PM===i?'on':''}${!L.length&&PM!==i?' zero':''}${L.some(late)?' has-late':''}" onclick="setMonth(${i})">${MABR[i-1]}${L.length?`<i>${L.length}</i>`:''}</button>`}
  $('#tmonth').innerHTML=h;
  $('#per').textContent='· '+(PM?MESES[PM-1]+' ':'')+PY;
}

/* relatório mensal */
const pad2=n=>String(n).padStart(2,'0');
const fmt1=n=>n==null?'—':n.toLocaleString('pt-BR',{minimumFractionDigits:1,maximumFractionDigits:1});
function openRep(){
  const cy=today().slice(0,4);
  const years=[...new Set(S.recs.map(r=>r.dt.slice(0,4)).concat(cy))].sort().reverse();
  const y=PY||cy,m=PM||(y===cy?+today().slice(5,7):12);
  $('#ry').innerHTML=years.map(v=>`<option${v===y?' selected':''}>${v}</option>`).join('');
  $('#rm').innerHTML=MESES.map((n,i)=>`<option value="${i+1}"${i+1===m?' selected':''}>${n}</option>`).join('');
  repRender();rep.showModal();
}
function prevOf(d){return d.m===1?[String(+d.y-1),12]:[d.y,d.m-1]}
function repCmpRows(d,p){
  const it=[
    ['📥','Contratos inseridos',p.ins,d.ins,null,'n'],
    ['✅','Concluídos',p.con,d.con,'up','n'],
    ['🚨','Atrasados',p.atr,d.atr,'down','n'],
    ['⏳','Pendentes',p.pen,d.pen,'down','n'],
    ['⏱️','Tempo médio de retorno',p.media,d.media,'down','d'],
    ['🎯','Dentro do prazo',p.noPrazo,d.noPrazo,'up','p']
  ];
  return it.map(([ic,l,a,b,dir,k])=>{
    const fv=v=>v==null?'—':k==='d'?fmt1(v)+' dias':k==='p'?v+'%':v;
    let dl='Sem dados para comparar',cls='',bd='';
    if(a!=null&&b!=null){
      const df=b-a,ab=Math.abs(df);
      if(ab<0.05){dl='= Igual'}
      else{
        if(k==='n')dl=(df>0?'▲ ':'▼ ')+ab+(df>0?' a mais':' a menos');
        else if(k==='d')dl=(df>0?'▲ ':'▼ ')+fmt1(ab)+' dia(s) '+(df>0?'mais lento':'mais rápido');
        else dl=(df>0?'▲ ':'▼ ')+ab+' ponto(s) '+(df>0?'melhor':'pior');
        if(dir){const good=((dir==='up')===(df>0));cls=good?'cmp-good':'cmp-bad';bd=good?'cc-g':'cc-b'}
      }
    }
    return{ic,l,a:fv(a),b:fv(b),dl,cls,bd};
  });
}
function repVerdict(d,p){
  const pn=MESES[prevOf(d)[1]-1];
  if(!p.ins)return{t:'Sem dados do mês anterior',s:'Não há contratos em '+pn+' para comparar.',c:''};
  if(!p.con||!d.con)return{t:'Ainda não dá para comparar a velocidade',s:'Falta ter contratos concluídos nos dois meses. Quando houver, aqui aparece se o jurídico ficou mais rápido ou mais lento.',c:''};
  let s=0;
  if(d.media!=null&&p.media!=null&&Math.abs(d.media-p.media)>=0.05)s+=d.media<p.media?1:-1;
  if(d.noPrazo!=null&&p.noPrazo!=null&&d.noPrazo!==p.noPrazo)s+=d.noPrazo>p.noPrazo?1:-1;
  if(d.atr!==p.atr)s+=d.atr<p.atr?1:-1;
  const det='Tempo médio: '+fmt1(p.media)+' → '+fmt1(d.media)+' dias · Dentro do prazo: '+p.noPrazo+'% → '+d.noPrazo+'% · Atrasados: '+p.atr+' → '+d.atr;
  if(s>0)return{t:'Melhorou em relação a '+pn,s:det,c:'cmp-good'};
  if(s<0)return{t:'Piorou em relação a '+pn,s:det,c:'cmp-bad'};
  return{t:'Ficou igual a '+pn,s:det,c:''};
}
function repCmp(d){
  const [py,pm]=prevOf(d),p=repData(py,pm),rows=repCmpRows(d,p),v=repVerdict(d,p);
  const t=c=>c==='cmp-good'||c==='cc-g'?'is-good':c==='cmp-bad'||c==='cc-b'?'is-bad':'';
  return `<div class="rp-sh"><h3>Comparativo com o mês anterior</h3><span>${MESES[pm-1]} ${py} → ${MESES[d.m-1]} ${d.y}</span></div>`
   +`<div class="rp-v ${t(v.c)}"><div><div class="rp-vt">${v.t}</div><div class="rp-vs">${v.s}</div></div></div>`
   ;
}
function repData(y0,m0){
  const y=y0||$('#ry').value,m=m0||+$('#rm').value,ym=y+'-'+pad2(m);
  const L=S.recs.filter(r=>r.dt.slice(0,7)===ym).sort((a,b)=>a.dt.localeCompare(b.dt)||String(a.ctrl).localeCompare(String(b.ctrl),'pt-BR',{numeric:true}));
  const D=L.filter(r=>r.done),sl=r=>r.sla||5;
  const dias=D.map(r=>r.dias);
  return{y,m,ym,L,D,
    ins:L.length,con:D.length,
    conMes:S.recs.filter(r=>r.done&&r.done.slice(0,7)===ym).length,
    pen:L.filter(r=>status(r)==='pendente').length,
    atr:L.filter(r=>status(r)==='atrasado').length,
    foraPrazo:D.filter(r=>r.dias>sl(r)).length,
    media:D.length?dias.reduce((a,b)=>a+b,0)/D.length:null,
    noPrazo:D.length?Math.round(D.filter(r=>r.dias<=sl(r)).length/D.length*100):null,
    min:D.length?Math.min(...dias):null,max:D.length?Math.max(...dias):null};
}
function repRender(){
  const d=repData(),pct=d.noPrazo==null?0:d.noPrazo;
  const K=(l,v,c,e)=>`<div class="rp-k" style="--c:${c}"><small>${l}</small><b>${v}</b>${e?`<em>${e}</em>`:''}</div>`;
  const st=r=>{const k=status(r);return k==='concluido'?(r.dias>(r.sla||5)?['warn','Concluído fora do prazo']:['ok','Concluído']):k==='atrasado'?['late','Atrasado']:['pend','Pendente']};
  const logo='<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M7 21h10M5 7h14"/><path d="M5 7l-3 7a3.2 3.2 0 0 0 6 0L5 7zM19 7l-3 7a3.2 3.2 0 0 0 6 0l-3-7z"/></svg>';
  $('#repbody').innerHTML=`<div class="rp">`
    +`<div class="rp-hero"><div><div class="rp-eyebrow"><i></i>Relatório mensal</div><h2>${MESES[d.m-1]} <span>${d.y}</span></h2><p>Contratos por data de solicitação · posição em ${br(today())}</p></div>`
    +`<div class="rp-brand"><div><b>Controle Jurídico</b><small>Contratos</small></div><div class="rp-logo">${logo}</div></div></div>`
    +`<div class="rp-kpis">`
    +K('Inseridos',d.ins,'#7c5cff')
    +K('Concluídos',d.con,'var(--ok)',d.conMes!==d.con?`${d.conMes} concluído(s) no mês (qualquer origem)`:'')
    +K('Pendentes',d.pen,'#22d3ee')+K('Atrasados',d.atr,'var(--er)')
    +`</div><div class="rp-r2">`
    +`<div class="rp-s"><small>Dentro do prazo</small><div class="rp-ringrow"><div class="rp-ringw"><div class="rp-ring" style="--p:${pct}"></div><div class="rp-ringv">${d.noPrazo==null?'—':d.noPrazo+'%'}</div></div><div><em style="margin:0">${d.D.length?`${d.D.length-d.foraPrazo} de ${d.D.length} concluídos`:'Sem concluídos ainda'}</em><em>${d.D.length?`${d.foraPrazo} fora do prazo`:''}</em></div></div></div>`
    +`<div class="rp-s"><small>Média de retorno</small><b>${d.media==null?'—':fmt1(d.media)+' <span style="font-size:14px;font-weight:600;letter-spacing:0">dias</span>'}</b><em>dias úteis, entre os concluídos</em></div>`
    +`<div class="rp-s"><small>Amplitude de retorno</small><div class="rp-range"><div><b>${d.min==null?'—':d.min}</b><span>Mais rápido (dia/s)</span></div><div><b>${d.max==null?'—':d.max}</b><span>Mais demorado (dia/s)</span></div></div></div>`
    +`</div>`
    +repCmp(d)
    +`<div class="rp-sh"><h3>Contratos do mês</h3><span>${d.ins} registro(s)</span></div>`
    +`<div class="rp-tw"><table class="rp-t"><thead><tr><th>Controle</th><th>Razão social</th><th>Solicitação</th><th>Prazo</th><th>Conclusão</th><th style="text-align:center">Dias úteis</th><th>Situação</th></tr></thead><tbody>`
    +(d.L.length?d.L.map(r=>{const[c,l]=st(r);return `<tr><td>${esc(r.ctrl)}</td><td class="rz">${esc(r.rz)}</td><td>${br(r.dt)}</td><td>${br(r.prazo)}</td><td>${br(r.done)}</td><td class="num">${r.dias==null?'—':r.dias}</td><td><span class="rp-pill ${c}">${l}</span></td></tr>`}).join(''):'<tr><td colspan="7" class="rp-empty">Nenhum contrato solicitado neste mês.</td></tr>')
    +`</tbody></table></div>`
    +`<div class="rp-f"><span>Controle Jurídico · Contratos</span><span>Emitido em ${br(today())}</span></div>`
    +`</div>`;
}
function repCSV(){
  const d=repData();
  const stLbl=r=>{const k=status(r);return k==='concluido'?'Concluído':k==='atrasado'?'Atrasado':'Pendente'};
  const q=v=>'"'+String(v).replace(/"/g,'""')+'"';
  let c='Relatório mensal;'+MESES[d.m-1]+' '+d.y+'\n'
   +'Contratos inseridos;'+d.ins+'\nConcluídos;'+d.con+'\nPendentes;'+d.pen+'\nAtrasados;'+d.atr+'\n'
   +'Média de retorno (dias úteis);'+(d.media==null?'':fmt1(d.media))+'\nNo prazo;'+(d.noPrazo==null?'':d.noPrazo+'%')+'\n\n'
   +'Controle;Razão social;Solicitação;Prazo;Conclusão;Dias úteis;Situação\n'
   +d.L.map(r=>[q(r.ctrl),q(r.rz),br(r.dt),br(r.prazo),r.done?br(r.done):'',r.dias==null?'':r.dias,stLbl(r)].join(';')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+c],{type:'text/csv'}));a.download='relatorio-'+d.y+'-'+pad2(d.m)+'.csv';a.click();
}

function render(){
  const q=$('#q').value.toLowerCase(),ALL=S.recs;renderTabs(ALL);if(!PY)$('#per').textContent='';const A=ALL.filter(inPeriod),done=A.filter(r=>r.done);
  const avg=done.length?(done.reduce((a,r)=>a+r.dias,0)/done.length).toFixed(1):'—';
  const onTime=done.length?Math.round(done.filter(r=>r.dias<=(r.sla||5)).length/done.length*100)+'%':'—';
  const cards=[['Total',A.length,'','tot','📋'],['Pendentes',A.filter(r=>status(r)==='pendente').length,'pendente','pen','⏳'],['Atrasados',A.filter(r=>status(r)==='atrasado').length,'atrasado','atr','🚨'],['Concluídos',done.length,'concluido','con','✅'],['Média de dias',avg,null,'med','📊'],['No prazo',onTime,null,'prz','🎯']];
  $('#stats').innerHTML=cards.map(([l,v,f,c,ic])=>`<div class="card stat k-${c}${f!==null?' click':''}${f!==null&&f===FL?' active':''}" ${f!==null?`data-f="${f}"`:''}><div class="si">${ic}</div><small>${l}</small><b${c==='atr'&&v>0?' class="alert"':''}>${v}</b></div>`).join('');
  const cnt=k=>A.filter(r=>status(r)===k).length;
  $('#cnt').textContent=A.length;
  const rows=A.filter(r=>(!FL||status(r)===FL)&&(r.ctrl+r.rz).toLowerCase().includes(q));
  $('#tb').innerHTML=rows.length?rows.map(r=>{
    const s=status(r),left=bdBetween(today(),r.prazo);
    const pill=s==='concluido'?'<span class="pill p-ok">Concluído</span>':s==='atrasado'?`<span class="pill p-er">Atrasado ${-left}d</span>`:`<span class="pill ${left<=1?'p-wa':'p-pe'}">${left} dia(s) restante(s)</span>`;
    return`<tr class="r-${s}"><td><span class="ctl">${esc(r.ctrl)}</span></td><td class="rz">${esc(r.rz)}</td><td>${br(r.dt)}</td><td style="${s==='atrasado'?'color:var(--er);font-weight:700':'font-weight:600'}">${br(r.prazo)}</td><td>${pill}</td><td>${br(r.done)}</td><td>${r.dias==null?'—':r.dias+' dia(s) útil(eis)'}</td><td style="white-space:nowrap">${r.done?`<button class="un" onclick="reopen(${r.id})" title="Reabrir (concluído por engano)">↩ Desfazer</button>`:`<button class="ok" onclick="conclude(${r.id})">✓ Concluir</button>`} <button class="x" onclick="del(${r.id})" title="Excluir">✕</button></td></tr>`}).join('')
   :'<tr class="emptyrow"><td colspan="8" class="empty"><div>🗂️</div>Nenhum registro encontrado.</td></tr>';
}
function renderLog(){
  $('#lg').innerHTML=S.log.length?S.log.map(e=>`<tr><td style="white-space:nowrap">${new Date(e.ts).toLocaleString('pt-BR')}</td><td>${esc(e.tipo)}</td><td>${esc(e.subject)}</td><td style="font-size:12px;color:var(--mu)">${esc(e.to||'—')}</td><td><span class="pill p-${e.cls==='ok'?'ok':e.cls==='er'?'er':'wa'}">${esc(e.res)}</span></td></tr>`).join('')
   :'<tr><td colspan="5" class="empty">Nenhum e-mail disparado ainda.</td></tr>';
}

/* configuração: vários e-mails */
let tmp=[];
function openCfg(){tmp=[...S.to];$('#url').value=S.url;$('#em').value='';chips();cfg.showModal()}
function chips(){$('#chips').innerHTML=tmp.map((m,i)=>`<span class="chip">${esc(m)}<button onclick="tmp.splice(${i},1);chips()">×</button></span>`).join('')||'<span class="hint">Nenhum destinatário.</span>'}
function addEm(){const parts=$('#em').value.split(/[,;\s]+/).filter(Boolean);
  parts.forEach(m=>{if(/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(m)){if(!tmp.includes(m))tmp.push(m)}else toast('E-mail inválido: '+m)});
  $('#em').value='';chips()}
$('#em').onkeydown=e=>{if(e.key==='Enter'||e.key===','){e.preventDefault();addEm()}};
$('#em').onblur=addEm;
function saveCfg(){addEm();S.to=tmp;S.url=$('#url').value.trim();save();cfg.close();toast('Configuração salva ('+S.to.length+' destinatário(s)).')}
function exportCSV(){
  const h='Controle;Razão social;Solicitação;Prazo;Conclusão;Dias úteis gastos\n';
  const b=S.recs.map(r=>[r.ctrl,r.rz,br(r.dt),br(r.prazo),br(r.done),r.dias??''].join(';')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+h+b],{type:'text/csv'}));a.download='controle-juridico.csv';a.click();
}
renderLog();checkOverdue();setInterval(checkOverdue,60*60*1000);
</script>
