<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Controle Jurídico - Contratos</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0d17;--card:rgba(255,255,255,.05);--bd:rgba(255,255,255,.1);--tx:#e8eaf6;--mu:#8b90b0;--ac:#7c5cff;--ac2:#22d3ee;--ok:#34d399;--wa:#fbbf24;--er:#f87171}
@media(prefers-color-scheme:light){:root{--bg:#eef0fa;--card:rgba(255,255,255,.75);--bd:rgba(20,20,60,.1);--tx:#1a1c33;--mu:#666b8c}}
*{box-sizing:border-box;margin:0}
body{font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;padding:28px;
background-image:radial-gradient(600px 400px at 10% -10%,rgba(124,92,255,.35),transparent),radial-gradient(500px 400px at 100% 0,rgba(34,211,238,.22),transparent);background-attachment:fixed}
.wrap{max-width:1150px;margin:auto}
header{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:22px}
h1{font-size:26px;letter-spacing:-.5px}h1 span{background:linear-gradient(90deg,var(--ac),var(--ac2));-webkit-background-clip:text;color:transparent}
.sub{color:var(--mu);font-size:13px;margin-top:6px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.sub input{width:54px;padding:4px 6px;text-align:center;font-weight:700;border-radius:8px}
.tools{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.card{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:20px;backdrop-filter:blur(14px);margin-bottom:18px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.stats .card{margin:0;padding:16px}
.stat small{color:var(--mu);font-size:11px;text-transform:uppercase;letter-spacing:.8px}.stat b{display:block;font-size:28px;margin-top:4px}
.stat.click{cursor:pointer;transition:.2s}.stat.click:hover{transform:translateY(-2px);border-color:var(--ac)}
.stat.active{border-color:var(--ac);box-shadow:0 0 0 2px rgba(124,92,255,.35)}
form{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;align-items:end;margin-bottom:18px}
label{font-size:12px;color:var(--mu);display:flex;flex-direction:column;gap:6px}
input,select{background:rgba(127,127,160,.12);border:1px solid var(--bd);color:var(--tx);border-radius:11px;padding:11px 12px;font:inherit;outline:none}
input:focus,select:focus{border-color:var(--ac);box-shadow:0 0 0 3px rgba(124,92,255,.25)}
button{border:0;border-radius:11px;padding:11px 16px;font:inherit;font-weight:600;cursor:pointer;color:#fff;background:linear-gradient(135deg,var(--ac),#5b8cff);transition:.2s}
button:hover{filter:brightness(1.12)}
button.sm{background:var(--card);border:1px solid var(--bd);color:var(--tx);padding:6px 11px;font-size:12px;font-weight:500;border-radius:9px}
button.sm:hover{border-color:var(--ac)}
button.test{background:transparent;border:1px dashed var(--wa);color:var(--wa)}
button.ok{background:linear-gradient(135deg,#10b981,#34d399);padding:7px 11px;font-size:12px}
button.un{background:rgba(251,191,36,.15);color:var(--wa);padding:7px 11px;font-size:12px}
button.x{background:transparent;color:var(--mu);padding:7px 9px;font-size:12px}
.bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.bar input,.bar select{flex:1;min-width:160px}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:14px;min-width:780px}
th{text-align:left;color:var(--mu);font-size:11px;text-transform:uppercase;letter-spacing:.8px;padding:10px;border-bottom:1px solid var(--bd)}
td{padding:12px 10px;border-bottom:1px solid var(--bd)}tr:last-child td{border:0}
.pill{padding:4px 10px;border-radius:99px;font-size:12px;font-weight:600;white-space:nowrap}
.p-ok{background:rgba(52,211,153,.15);color:var(--ok)}.p-wa{background:rgba(251,191,36,.15);color:var(--wa)}.p-er{background:rgba(248,113,113,.17);color:var(--er)}.p-pe{background:rgba(124,92,255,.17);color:#a99bff}
.empty{text-align:center;color:var(--mu);padding:26px}
h3{font-size:15px;margin-bottom:4px}.hint{color:var(--mu);font-size:12px;margin-bottom:12px}
#toast{position:fixed;bottom:22px;right:22px;display:flex;flex-direction:column;gap:8px;z-index:99}
.t{background:#171a2e;color:#fff;border:1px solid var(--bd);border-left:4px solid var(--ac2);padding:12px 16px;border-radius:12px;font-size:13px;max-width:340px;display:flex;gap:12px;align-items:center}
.t button{padding:5px 10px;font-size:12px;background:var(--wa);color:#222}
dialog{background:var(--bg);color:var(--tx);border:1px solid var(--bd);border-radius:18px;padding:24px;max-width:580px;width:92%}
dialog{margin:auto;position:fixed;inset:0;max-height:90vh;overflow:auto}
#hist{max-width:1000px!important}
#hist .tw{overflow-x:visible}
#lgt th,#lgt td{padding:10px 8px;font-size:13px}
#lgt td{white-space:normal;word-break:break-word;overflow-wrap:anywhere;vertical-align:top}
#lgt td:first-child{white-space:nowrap;width:1%}
#lgt td:nth-child(2){width:1%;white-space:nowrap}
#lgt td:last-child{width:1%;white-space:nowrap}
dialog::backdrop{background:rgba(0,0,0,.6);backdrop-filter:blur(4px)}
dialog label{margin-bottom:12px}pre{background:rgba(127,127,160,.15);padding:12px;border-radius:10px;font-size:11px;overflow:auto;white-space:pre-wrap}
details{margin:4px 0 14px;font-size:13px;color:var(--mu)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 14px}
.chip{background:rgba(124,92,255,.17);color:#a99bff;border-radius:99px;padding:5px 6px 5px 12px;font-size:12px;display:flex;gap:6px;align-items:center}
.chip button{background:none;padding:0 6px;font-size:14px;color:inherit}

/* ===== visual premium v2 ===== */
body{padding:34px 28px}
@keyframes in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.card{box-shadow:0 12px 34px rgba(0,0,0,.14);animation:in .45s ease both}
.brand{display:flex;align-items:center;gap:14px;margin-bottom:12px}
.logo{width:48px;height:48px;border-radius:15px;display:grid;place-items:center;font-size:25px;background:linear-gradient(135deg,var(--ac),var(--ac2));box-shadow:0 10px 26px rgba(124,92,255,.45)}
h1{font-size:30px;font-weight:800;letter-spacing:-1px}
.sub{display:inline-flex;background:var(--card);border:1px solid var(--bd);border-radius:99px;padding:6px 8px 6px 14px}
.sub input{border-radius:99px;background:rgba(124,92,255,.18);border-color:transparent}
.tools button.sm{padding:8px 14px}
.stats{gap:14px;margin-bottom:22px}
.stats .stat{position:relative;overflow:hidden;padding:20px 18px 16px}
.stat::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--k,var(--ac))}
.si{position:absolute;right:14px;top:16px;width:34px;height:34px;border-radius:11px;display:grid;place-items:center;font-size:17px;background:color-mix(in srgb,var(--k,#7c5cff) 18%,transparent)}
.stat small{font-weight:600}
.stat b{font-size:34px;font-weight:800;letter-spacing:-1.5px;margin-top:8px}
.k-tot{--k:#7c5cff}.k-pen{--k:#5b8cff}.k-atr{--k:#f87171}.k-con{--k:#34d399}.k-med{--k:#22d3ee}.k-prz{--k:#fbbf24}
.k-atr b{color:var(--er)}.k-con b{color:var(--ok)}
.stat.click:hover{box-shadow:0 14px 34px color-mix(in srgb,var(--k) 30%,transparent)}
.sec{display:flex;align-items:baseline;gap:10px;margin-bottom:14px}
.sec h3{font-size:17px;font-weight:700;margin:0}.sec .hint{margin:0}
#cnt{background:rgba(124,92,255,.2);color:#a99bff;border-radius:99px;padding:2px 10px;font-size:12px;font-weight:700;margin-left:6px}
form{margin-bottom:0}
form label{font-weight:600;letter-spacing:.2px}
form button{box-shadow:0 10px 24px rgba(124,92,255,.4);height:44px}
.bar{align-items:center}
#fl{display:none}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{background:var(--card);border:1px solid var(--bd);color:var(--mu);padding:9px 14px;font-size:13px;font-weight:600;border-radius:99px}
.seg button span{background:rgba(127,127,160,.2);border-radius:99px;padding:1px 8px;margin-left:4px;font-size:11px}
.seg button.on{background:linear-gradient(135deg,var(--ac),#5b8cff);color:#fff;border-color:transparent;box-shadow:0 6px 16px rgba(124,92,255,.4)}
.seg button.on span{background:rgba(255,255,255,.25)}
.bar input{min-width:240px}
table{border-collapse:separate;border-spacing:0 7px}
th{border:0;padding:6px 12px}
td{border:0;padding:14px 12px;background:rgba(127,127,160,.07);transition:background .2s}
tr:hover td{background:rgba(124,92,255,.13)}
td:first-child{border-radius:12px 0 0 12px}td:last-child{border-radius:0 12px 12px 0}
tr.r-atrasado td:first-child{box-shadow:inset 4px 0 0 var(--er)}
tr.r-pendente td:first-child{box-shadow:inset 4px 0 0 var(--ac)}
tr.r-concluido td:first-child{box-shadow:inset 4px 0 0 var(--ok)}
.ctl{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:700;font-size:13px;background:rgba(124,92,255,.17);color:var(--ac);padding:5px 11px;border-radius:9px;display:inline-block;margin-left:6px}
@media(prefers-color-scheme:dark){.ctl{color:#a99bff}}
td{white-space:nowrap}td.rz{font-weight:700}
.pill{padding:5px 12px}
.pill::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor;margin-right:7px;vertical-align:middle}
button.x:hover{background:rgba(248,113,113,.18);color:var(--er)}
button.ok{box-shadow:0 6px 14px rgba(16,185,129,.35)}
tr.emptyrow:hover td{background:transparent}
.empty{padding:44px 20px;font-size:14px}.empty div{font-size:34px;margin-bottom:8px}
dialog{box-shadow:0 30px 80px rgba(0,0,0,.5)}

/* ===== painéis sóbrios ===== */
h1 span.h1-sub{background:none;-webkit-background-clip:initial;background-clip:initial;color:var(--tx);-webkit-text-fill-color:var(--tx)}
.stats .stat{padding:18px 20px;border-radius:14px;box-shadow:0 1px 2px rgba(0,0,0,.08);background:var(--card)}
.stat::before{display:block;height:2px;opacity:.75}
.si{display:none}
.stat small{font-size:11px;font-weight:600;letter-spacing:.9px;color:var(--mu)}
.stat b{font-size:30px;font-weight:700;letter-spacing:-.8px;margin-top:6px;color:var(--tx)}
.k-atr b{color:var(--tx)}.k-con b{color:var(--tx)}
.k-atr b.alert{color:var(--er)}
.stat.click:hover{transform:none;box-shadow:0 4px 14px rgba(0,0,0,.14);border-color:rgba(127,127,160,.45)}
.stat.active{border-color:var(--tx);box-shadow:0 0 0 1px var(--tx)}

/* ===== marca sóbria ===== */
.brand{gap:14px}
.logo{width:44px;height:44px;border-radius:12px;background:var(--tx);color:var(--bg);box-shadow:0 2px 8px rgba(0,0,0,.18)}
h1{display:flex;align-items:center;gap:14px;font-size:24px;font-weight:700;letter-spacing:-.4px;color:var(--tx);flex-wrap:wrap}
h1 .h1-div{width:1px;height:22px;background:var(--bd);background:rgba(127,127,160,.45)}
h1 span.h1-sub{font-size:15px;font-weight:500;letter-spacing:.2px;color:var(--mu);-webkit-text-fill-color:var(--mu)}

/* ===== abas de período ===== */
.periodo{margin-bottom:18px;display:flex;flex-direction:column;gap:10px}
.tabs{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.tabs button{position:relative;background:transparent;border:1px solid transparent;color:var(--mu);padding:7px 13px;font-size:13px;font-weight:600;border-radius:9px;box-shadow:none;height:auto;cursor:pointer}
.tabs button:hover{background:rgba(127,127,160,.12);color:var(--tx)}
.tabs button.on{background:var(--tx);color:var(--bg);border-color:var(--tx)}
.tabs button i{font-style:normal;font-size:11px;font-weight:700;margin-left:6px;padding:1px 7px;border-radius:99px;background:rgba(127,127,160,.18)}
.tabs button.on i{background:rgba(127,127,160,.35)}
.tabs button.zero{opacity:.45}
.tabs button.has-late::after{content:"";position:absolute;top:4px;right:4px;width:6px;height:6px;border-radius:50%;background:var(--er)}
.tabs.years button{font-size:14px;padding:8px 16px}
.tabs select{width:auto;min-width:0;padding:7px 30px 7px 12px;font-size:14px;font-weight:700;border-radius:9px;margin-right:6px;cursor:pointer}
.per{background:none!important;color:var(--mu)!important;font-weight:500!important;padding:0!important;margin-left:8px!important;font-size:13px}

/* ===== comparativo ===== */
.cmp-good{color:var(--ok)}.cmp-bad{color:var(--er)}
/* ===== relatório mensal — design moderno (tela + PDF) ===== */
.rp{--r-mu:var(--mu);--r-bd:rgba(127,127,160,.22);--r-card:rgba(127,127,160,.08);--r-track:rgba(127,127,160,.22);
  -webkit-print-color-adjust:exact;print-color-adjust:exact;font-variant-numeric:tabular-nums;line-height:1.35}
.rp *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
.rp-hero{position:relative;overflow:hidden;border-radius:16px;padding:18px 22px;color:#fff;display:flex;justify-content:space-between;align-items:flex-end;gap:18px;
  background:radial-gradient(420px 240px at 100% -30%,rgba(34,211,238,.50),transparent 70%),radial-gradient(420px 280px at 0% 130%,rgba(124,92,255,.75),transparent 70%),linear-gradient(135deg,#0a0c18 0%,#171548 100%)}
.rp-hero::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:26px 26px;-webkit-mask-image:linear-gradient(120deg,transparent 35%,#000 100%);mask-image:linear-gradient(120deg,transparent 35%,#000 100%);pointer-events:none}
.rp-hero>*{position:relative;z-index:1}
.rp-eyebrow{display:flex;align-items:center;gap:8px;font-size:9.5px;font-weight:700;letter-spacing:2.2px;text-transform:uppercase;color:rgba(255,255,255,.7)}
.rp-eyebrow i{width:26px;height:2px;border-radius:2px;background:linear-gradient(90deg,#7c5cff,#22d3ee)}
.rp-hero h2{font-size:26px;font-weight:800;letter-spacing:-.9px;line-height:1.05;margin:8px 0 5px;color:#fff}
.rp-hero h2 span{background:linear-gradient(90deg,#b4a6ff,#67e8f9);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
.rp-hero p{font-size:11px;color:rgba(255,255,255,.68)}
.rp-brand{display:flex;align-items:center;gap:12px;text-align:right}
.rp-brand b{display:block;font-size:13px;font-weight:700;color:#fff;letter-spacing:-.1px}
.rp-brand small{display:block;font-size:11px;color:rgba(255,255,255,.62);margin-top:2px}
.rp-logo{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;color:#fff;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);box-shadow:inset 0 1px 0 rgba(255,255,255,.2)}

.rp-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0 8px}
.rp-k{position:relative;overflow:hidden;border:1px solid var(--r-bd);background:var(--r-card);border-radius:12px;padding:10px 12px 10px 16px}
.rp-k::before{content:"";position:absolute;left:0;top:14px;bottom:14px;width:4px;border-radius:0 4px 4px 0;background:var(--c)}
.rp-k small,.rp-cl,.rp-s small{display:block;font-size:10px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:var(--r-mu)}
.rp-k b{display:block;font-size:26px;font-weight:800;letter-spacing:-1.2px;line-height:1.05;margin-top:4px}
.rp-k em{display:block;font-style:normal;font-size:11px;color:var(--r-mu);margin-top:5px}

.rp-r2{display:grid;grid-template-columns:1.15fr 1fr 1.25fr;gap:8px}
.rp-s{border:1px solid var(--r-bd);background:var(--r-card);border-radius:12px;padding:10px 14px;display:flex;flex-direction:column;justify-content:center}
.rp-s b{display:block;font-size:20px;font-weight:800;letter-spacing:-.7px;margin-top:4px;line-height:1.1}
.rp-s em{display:block;font-style:normal;font-size:11px;color:var(--r-mu);margin-top:4px}
.rp-ringrow{display:flex;align-items:center;gap:14px;margin-top:8px}
.rp-ringw{position:relative;width:54px;height:54px;flex:none}
.rp-ring{position:absolute;inset:0;border-radius:50%;background:conic-gradient(var(--ok) calc(var(--p)*1%),var(--r-track) 0);-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 8px),#000 calc(100% - 7px));mask:radial-gradient(farthest-side,transparent calc(100% - 10px),#000 calc(100% - 9px))}
.rp-ringv{position:absolute;inset:0;display:grid;place-items:center;font-size:12px;font-weight:800;letter-spacing:-.4px}
.rp-range{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:6px}
.rp-range b{font-size:18px;margin-top:2px}.rp-range span{font-size:11px;color:var(--r-mu)}

.rp-sh{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:18px 0 9px;padding-bottom:7px;border-bottom:1px solid var(--r-bd);break-after:avoid}
.rp-sh h3{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:800;letter-spacing:-.4px;margin:0}
.rp-sh h3::before{content:"";width:8px;height:8px;border-radius:3px;background:linear-gradient(135deg,#7c5cff,#22d3ee)}
.rp-sh span{font-size:11.5px;color:var(--r-mu);font-weight:500}

.rp-v{--c:#8b90b0;display:flex;align-items:center;gap:14px;border:1px solid var(--r-bd);background:var(--r-card);border-radius:12px;padding:11px 14px}
.rp-v::before{content:"";flex:none;width:10px;height:10px;border-radius:50%;background:var(--c);box-shadow:0 0 0 5px color-mix(in srgb,var(--c) 22%,transparent)}
.rp-v.is-good{--c:var(--ok);background:rgba(52,211,153,.09);border-color:rgba(52,211,153,.35)}
.rp-v.is-bad{--c:var(--er);background:rgba(248,113,113,.09);border-color:rgba(248,113,113,.35)}
.rp-vt{font-size:14px;font-weight:800;letter-spacing:-.4px}.rp-vs{font-size:11px;color:var(--r-mu);margin-top:4px}
.rp-cg{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}
.rp-c{--c:#8b90b0;border:1px solid var(--r-bd);background:var(--r-card);border-radius:16px;padding:14px 16px;position:relative;overflow:hidden}
.rp-c::after{content:"";position:absolute;left:16px;right:16px;top:0;height:3px;border-radius:0 0 4px 4px;background:var(--c)}
.rp-c.is-good{--c:var(--ok)}.rp-c.is-bad{--c:var(--er)}
.rp-cv{font-size:28px;font-weight:800;letter-spacing:-1.2px;margin-top:7px;line-height:1.1}
.rp-cp{font-size:11px;color:var(--r-mu);margin-top:3px}
.rp-d{display:inline-block;margin-top:10px;padding:4px 10px;border-radius:99px;font-size:11px;font-weight:700;background:rgba(127,127,160,.16);color:var(--r-mu)}
.rp-d.is-good{background:rgba(52,211,153,.16);color:var(--ok)}.rp-d.is-bad{background:rgba(248,113,113,.17);color:var(--er)}

.rp-tw{overflow-x:auto}
.rp-t{width:100%;min-width:0;border-collapse:separate;border-spacing:0;font-size:11px}
.rp-t th{padding:9px 10px;font-size:9.5px;font-weight:700;letter-spacing:1.1px;text-transform:uppercase;color:var(--r-mu);background:rgba(127,127,160,.12);border:0;white-space:nowrap}
.rp-t th:first-child{border-radius:10px 0 0 10px}.rp-t th:last-child{border-radius:0 10px 10px 0}
.rp-t td{padding:8px 10px;border:0;border-bottom:1px solid var(--r-bd);background:none!important;white-space:nowrap;vertical-align:middle}
.rp-t tr:hover td{background:none!important}
.rp-t td.rz{white-space:normal;min-width:150px;width:32%}
.rp-t tr:last-child td{border-bottom:0!important}
.rp-t thead{display:table-header-group}.rp-t tr{break-inside:avoid}
.rp-t td:first-child{font-weight:800;letter-spacing:-.2px}.rp-t td.rz{font-weight:600}
.rp-t td.num{text-align:center;font-weight:700}
.rp-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:99px;font-size:10.5px;font-weight:700;white-space:nowrap}
.rp-pill::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.rp-pill.ok{background:rgba(52,211,153,.16);color:var(--ok)}.rp-pill.late{background:rgba(248,113,113,.17);color:var(--er)}
.rp-pill.pend{background:rgba(124,92,255,.16);color:#a99bff}.rp-pill.warn{background:rgba(251,191,36,.18);color:var(--wa)}
