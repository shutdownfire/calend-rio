    <select id="fl"><option value="">Todos</option><option value="pendente">Pendentes</option><option value="atrasado">Atrasados</option><option value="concluido">Concluídos</option></select>
  </div>
  <div class="tw"><table><thead><tr><th>Controle</th><th>Razão social</th><th>Solicitação</th><th>Prazo</th><th>Status</th><th>Conclusão</th><th>Dias gastos</th><th></th></tr></thead><tbody id="tb"></tbody></table></div>
