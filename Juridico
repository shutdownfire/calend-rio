  #rep .rp{--r-mu:#6b7090;--r-bd:#e3e5f1;--r-card:#f6f7fc;--r-track:#e6e8f4;--ok:#059669;--er:#dc2626;--wa:#b45309;color:#0f1226}
  #rep .rp-hero h2 span{background:none;-webkit-text-fill-color:#b9aeff;color:#b9aeff}
  #rep .rp-pill.pend{color:#6d4aff}
  .rp-k,.rp-s,.rp-c,.rp-v,.rp-hero{break-inside:avoid}
  .rp-tw{overflow:visible}
}
